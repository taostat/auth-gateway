# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Reverse proxy trust. Set explicitly in production (e.g. true, 1, or ingress IP/CIDR list).
TRUST_PROXY=false

# Network: "mainnet" or "testnet" (defaults to mainnet)
# When testnet, auto-connects to test.finney.opentensor.ai unless SUBTENSOR_WS_URL is set
NETWORK=mainnet

# RSA Keys (file paths or base64-encoded)
RSA_PRIVATE_KEY_PATH=keys/private.pem
RSA_PUBLIC_KEY_PATH=keys/public.pem
# RSA_PRIVATE_KEY_BASE64=
# RSA_PUBLIC_KEY_BASE64=

# JWT
# Keep JWT_ISSUER aligned with PUBLIC_URL for OIDC consistency
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=bittensor-apps
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=86400
JWT_AUTH_CODE_EXPIRY=30

# Subtensor
SUBTENSOR_WS_URL=wss://entrypoint-finney.opentensor.ai:443
SUBTENSOR_BLOCK_TIME=12

# Taostats API (holder fallback + indexed scopes like delegate/staker)
TAOSTATS_API_URL=https://api.taostats.io
# Required for delegate/staker scopes
# TAOSTATS_API_KEY=

# Challenge
CHALLENGE_TTL_SECONDS=120

# Device Code Flow
DEVICE_CODE_TTL_SECONDS=300
DEVICE_CODE_POLL_INTERVAL=5
VERIFICATION_URI=http://localhost:3000/v1/device/verify

# Rate Limits
RATE_LIMIT_GLOBAL=10
RATE_LIMIT_CHALLENGE=5

# Database
DATABASE_URL=postgresql://auth:auth_dev_password@localhost:5432/auth_gateway

# Admin API (required in production — generate a strong random value)
# ADMIN_API_KEY=

# Migrations (auto-run on startup)
RUN_MIGRATIONS=true

# Public URL (for OIDC discovery)
PUBLIC_URL=http://localhost:3000

# Demo mode (auto-creates clients, serves interactive landing page)
# DEMO_MODE=false
